# Copy this file to server/.env and fill in real values.
# Get these from your Supabase project: Settings → API.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# service_role key — NOT the anon/public key. This bypasses Row Level
# Security, so it must stay server-side only. Never commit this file.
SUPABASE_SERVICE_ROLE_KEY=

# Port the Express server listens on locally.
PORT=3001

# Comma-separated list of origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,https://geschichte.co
