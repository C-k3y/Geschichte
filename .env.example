# Environment variables for SOIVANT landing page
# Copy this file to .env.local and fill in the real values.
# Never commit .env.local to git.

# Formspree form ID — get yours at https://formspree.io
# 1. Sign up / log in
# 2. Create a new form (name it "Waitlist")
# 3. Copy the 8-character ID from the endpoint URL
# 4. Paste it here (just the ID, not the full URL)
VITE_FORMSPREE_ID=xxxxxxxx

# Plausible Analytics domain — matches the domain you added in Plausible
# https://plausible.io/sites
VITE_PLAUSIBLE_DOMAIN=soivant.co
